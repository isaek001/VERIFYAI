# Copy to server/.env and fill in. Never commit the real file.

# --- Required --------------------------------------------------------------
# Supabase Postgres connection string (Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres

# --- Vision (photo -> text) ------------------------------------------------
# VISION_PROVIDER: auto (default) | gemini | tesseract
VISION_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Official results ------------------------------------------------------
# RESULT_PROVIDER: auto (default) | live | fixture | kakaverify
#   auto    -> real provider when configured; demo fixture outside production,
#              fail-closed (not-configured error) in production
#   live    -> always the real provider
#   fixture -> always the demo fixture (explicit opt-in, any environment)
RESULT_PROVIDER=auto
WAEC_API_SECRET=
WAEC_SANDBOX=0
NECO_API_KEY=
NECO_TOKEN=
NECO_PAYREF=
NABTEB_API_BASE_URL=https://api.nabteb.gov.ng

# --- KakaVerify (spends real wallet money) ---------------------------------
KAKAVERIFY_API_KEY=
KAKAVERIFY_BASE_URL=https://www.app.kakaverify.ng/auth/api/v1
KAKAVERIFY_PHONE=

# --- Optional hardening ----------------------------------------------------
# Re-enable the seeded demo account in production:
#ALLOW_DEMO_LOGIN=1
# Restrict sign-up to specific email domains (comma separated):
#ALLOWED_EMAIL_DOMAINS=fcahpt.gov.ng
# Extra browser origins allowed to call the API cross-origin:
#CORS_ORIGIN=https://staging.example.com
